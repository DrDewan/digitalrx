+type Row = Record<string, unknown>;
+type Result = { data: unknown; error: null };
+
+function relationShape(table: string, rows: Row[]): Row[] {
+  if (table === "patients") {
+    return rows.map((row) => ({
+      ...row,
+      prescriptions: [{ count: prescriptions.filter((rx) => rx.patient_id === row.id).length }],
+    }));
+  }
+  if (table === "prescriptions") {
+    return rows.map((row) => ({
+      ...row,
+      patients: patients.find((patient) => patient.id === row.patient_id)
+        ? {
+            id: patients.find((patient) => patient.id === row.patient_id)!.id,
+            name: patients.find((patient) => patient.id === row.patient_id)!.name,
+          }
+        : null,
+    }));
+  }
+  return rows;
+}
+
+function tableRows(table: string): Row[] {
+  if (table === "profiles") return [profile as unknown as Row];
+  if (table === "patients") return relationShape(table, patients as unknown as Row[]);
+  if (table === "prescriptions") return relationShape(table, prescriptions as unknown as Row[]);
+  if (table === "templates") return templates as unknown as Row[];
+  if (table === "medicines_all" || table === "medicines" || table === "medicine_catalog") {
+    return medicines as unknown as Row[];
+  }
+  return [];
+}
+
+class DemoQuery implements PromiseLike<Result> {
+  private rows: Row[];
+  private singleMode = false;
+  private mutation: "insert" | "update" | "upsert" | "delete" | null = null;
+  private mutationPayload: Row | Row[] | null = null;
+
+  constructor(private table: string) {
+    this.rows = tableRows(table);
+  }
+
+  select(_columns = "*") {
+    return this;
+  }
+
+  eq(column: string, value: unknown) {
+    this.rows = this.rows.filter((row) => row[column] === value);
+    return this;
+  }
+
+  ilike(column: string, pattern: string) {
+    const needle = pattern.replace(/^%|%$/g, "").replace(/\\([%_\\])/g, "$1").toLowerCase();
+    this.rows = this.rows.filter((row) => String(row[column] ?? "").toLowerCase().includes(needle));
+    return this;
+  }
+
+  or(expression: string) {
+    const terms = Array.from(expression.matchAll(/([a-zA-Z0-9_]+)\.ilike\.([^,]+)/g));
+    if (terms.length) {
+      this.rows = this.rows.filter((row) =>
+        terms.some(([, column, pattern]) => {
+          const needle = pattern.replace(/^%|%$/g, "").replace(/\\([%_\\])/g, "$1").toLowerCase();
+          return String(row[column] ?? "").toLowerCase().includes(needle);
+        }),
+      );
+    }
+    return this;
+  }
+
+  in(column: string, values: unknown[]) {
+    this.rows = this.rows.filter((row) => values.includes(row[column]));
+    return this;
+  }
+
+  order(column: string, options?: { ascending?: boolean }) {
+    const direction = options?.ascending === false ? -1 : 1;
+    this.rows = [...this.rows].sort((a, b) =>
+      String(a[column] ?? "").localeCompare(String(b[column] ?? "")) * direction,
+    );
+    return this;
+  }
+
+  limit(count: number) {
+    this.rows = this.rows.slice(0, count);
+    return this;
+  }
+
+  insert(payload: Row | Row[]) {
+    this.mutation = "insert";
+    this.mutationPayload = payload;
+    return this;
+  }
+
+  update(payload: Row) {
+    this.mutation = "update";
+    this.mutationPayload = payload;
+    return this;
+  }
+
+  upsert(payload: Row | Row[], _options?: unknown) {
+    this.mutation = "upsert";
+    this.mutationPayload = payload;
+    return this;
+  }
+
+  delete() {
+    this.mutation = "delete";
+    return this;
+  }
+
+  single() {
+    this.singleMode = true;
+    return this;
+  }
+
+  maybeSingle() {
+    this.singleMode = true;
+    return this;
+  }
+
+  private result(): Result {
+    if (this.mutation === "delete") return { data: null, error: null };
+
+    if (this.mutation === "insert" || this.mutation === "upsert") {
+      const payload = Array.isArray(this.mutationPayload)
+        ? (this.mutationPayload[0] ?? {})
+        : (this.mutationPayload ?? {});
+      if (this.table === "prescriptions") {
+        return { data: { ...payload, id: "demo-rx-local", serial: 1043 }, error: null };
+      }
+      if (this.table === "patients") {
+        return { data: { ...payload, id: "demo-patient-local" }, error: null };
+      }
+      if (this.table === "templates") {
+        return { data: { ...payload, id: "demo-template-local" }, error: null };
+      }
+      if (this.table === "medicines") {
+        return { data: { ...payload, id: "demo-medicine-local" }, error: null };
+      }
+      return { data: payload, error: null };
+    }
+
+    if (this.mutation === "update") {
+      const first = this.rows[0] ?? {};
+      return { data: { ...first, ...(this.mutationPayload ?? {}) }, error: null };
+    }
+
+    if (this.singleMode) return { data: this.rows[0] ?? null, error: null };
+    return { data: this.rows, error: null };
+  }
+
+  then<TResult1 = Result, TResult2 = never>(
+    onfulfilled?: ((value: Result) => TResult1 | PromiseLike<TResult1>) | null,
+    onrejected?: ((reason: unknown) => TResult2 | PromiseLike<TResult2>) | null,
+  ): PromiseLike<TResult1 | TResult2> {
+    return Promise.resolve(this.result()).then(onfulfilled, onrejected);
+  }
+}
