+              user_metadata: { doctor_name: profile.doctor_name },
+            },
+          },
+          error: null,
+        };
+      },
+      async signInWithPassword(_credentials: { email: string; password: string }) {
+        return { data: { user: { id: USER_ID }, session: { access_token: "demo" } }, error: null };
+      },
+      async signUp(_credentials: unknown) {
+        return { data: { user: { id: USER_ID }, session: { access_token: "demo" } }, error: null };
+      },
+      async signOut() {
+        return { error: null };
+      },
+    },
+    from(table: string) {
+      return new DemoQuery(table);
+    },
+    async rpc(name: string, args?: { q?: string; lim?: number }) {
+      if (name !== "search_patients") return { data: [], error: null };
+      const needle = String(args?.q ?? "").trim().toLowerCase();
+      const limit = args?.lim ?? 25;
+      return {
+        data: patients
+          .filter((patient) =>
+            !needle || [patient.name, patient.phone, patient.mrn].some((value) => value.toLowerCase().includes(needle)),
+          )
+          .slice(0, limit),
+        error: null,
+      };
+    },
+  };
+}
