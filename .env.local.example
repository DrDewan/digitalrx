# Copy to .env.local for local development, and add the same two values to
# Vercel → Project → Settings → Environment Variables.
#
# Both come from Supabase → Project Settings → API.
# The anon key is safe to expose to the browser: every table is protected by
# row-level security, so it can only ever read the signed-in doctor's own rows.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
